{
  "service_name": "intentide-engine",
  "framework": "INTENTIDE",
  "version": "1.2.0",
  "author": "Haxhijaha, Agim",
  "orcid": "0009-0002-3234-7765",
  "minimum_viable_deployment": {
    "compute": "2 vCPU",
    "memory": "2 GiB",
    "storage": "10 GiB SSD",
    "network": "HTTPS ingress + private VPC for inter-service mTLS"
  },
  "dependencies": [
    "Python 3.11+ stdlib runtime (reference PoC)",
    "structured JSON log sink",
    "TLS-terminating reverse proxy"
  ],
  "environment_variables": [
    "INTENTIDE_ENV=staging|production",
    "INTENTIDE_LOG_LEVEL=INFO",
    "INTENTIDE_AUDIT_PATH=/var/log/intentide-engine",
    "INTENTIDE_MAX_BATCH=1000"
  ],
  "health_check_endpoint": "/health",
  "api_base_path": "/api/v1/intentide",
  "estimated_latency_p99": "30-150ms p99 (500 agents, stability rounds)",
  "estimated_throughput": "40-120 settlements/min",
  "scaling_model": "horizontal",
  "security_requirements": [
    "TLS 1.3",
    "mTLS for inter-service",
    "signed audit events",
    "least-privilege service account"
  ],
  "monitoring": {
    "metrics": [
      "request_latency_ms",
      "jobs_completed_total",
      "error_rate",
      "peak_memory_mb",
      "bottleneck_proxy:coalition_sample"
    ],
    "alerts": [
      "p99_latency > 2x baseline",
      "error_rate > 1%",
      "memory > 80% of limit"
    ],
    "log_format": "structured JSON"
  },
  "stress_basis": {
    "1x_total_seconds": 0.015915,
    "1x_peak_mb": 0.3766,
    "bottleneck_operation": "coalition_sample",
    "note": "Full O(n\u00b2) coalition detection must stay sampled or redesigned"
  },
  "estimated_monthly_cost_usd": "$50-140/month",
  "disclaimer": "Order-of-magnitude estimates from PoC stress tests; not a vendor quote."
}